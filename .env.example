# Public configuration bundled into the Expo app. Never put secret/service-role keys here.
# Default: bundled. Set to supabase to progressively load approved, published updates.
# Missing/unpublished places keep their bundled versions; no login is required.
EXPO_PUBLIC_CONTENT_SOURCE=bundled
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
